{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash '__SCRIPT__' SessionStart", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bash '__SCRIPT__' UserPromptSubmit", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bash '__SCRIPT__' PreToolUse", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bash '__SCRIPT__' PostToolUse", "timeout": 10 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bash '__SCRIPT__' PermissionRequest", "timeout": 10 }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bash '__SCRIPT__' PreCompact", "timeout": 10 }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bash '__SCRIPT__' PostCompact", "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bash '__SCRIPT__' SubagentStart", "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bash '__SCRIPT__' SubagentStop", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bash '__SCRIPT__' Stop", "timeout": 10 }
        ]
      }
    ],
    "Interrupt": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bash '__SCRIPT__' Interrupt", "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bash '__SCRIPT__' SessionEnd", "timeout": 10 }
        ]
      }
    ]
  }
}
